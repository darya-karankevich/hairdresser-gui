<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hairdresser.gui.MainController">
    <top>
        <MenuBar>
            <Menu text="Файл">
                <MenuItem text="Выход" onAction="#exit"/>
            </Menu>
            <Menu text="Справочники">
                <MenuItem text="Пользователи" onAction="#showUsers"/>
                <MenuItem text="Роли пользователей" onAction="#showRoles"/>
                <MenuItem text="Виды услуг" onAction="#showServiceTypes"/>
            </Menu>
            <Menu text="Операции">
                <MenuItem text="Запись клиента" onAction="#bookClient"/>
                <MenuItem text="Добавление новой услуги" onAction="#addService"/>
                <MenuItem text="Формирование списка свободных мест" onAction="#listFreeSlots"/>
                <MenuItem text="Расписание мастера" onAction="#showMasterSchedule"/>
                <MenuItem text="Отчет по клиентам" onAction="#showClientReport"/>
                <MenuItem text="Отчет по мастерам" onAction="#showMasterReport"/>
                <MenuItem text="Диаграмма выручки по мастерам" onAction="#showRevenueChart"/>
                <MenuItem text="Диаграмма клиентов по времени" onAction="#showClientsByTimeChart"/>
                <MenuItem text="Диаграмма прибыли по услугам" onAction="#showProfitByServiceChart"/>
                <MenuItem text="Расчет зарплаты мастеров" onAction="#showSalaryCalculation"/>
            </Menu>
            <Menu text="Справка">
                <MenuItem text="О программе" onAction="#showAbout"/>
            </Menu>
        </MenuBar>
    </top>
</BorderPane>